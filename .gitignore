# secrets and anything derived from a private cluster stay local
.env
.env.*
!.env.example
dev/litellm/config.cluster.yaml
dev/litellm/*.local.*

# generated by the engine on first load; tsc reads it
plugins/litellm-key/.claude-plugin/types/

# scratch from the evidence tooling
dev/evidence/.cache/
dev/evidence/__pycache__/
__pycache__/
node_modules/

# evidence taken against the real cluster routing: private, never committed
dev/evidence/cluster/
.playwright-mcp/
