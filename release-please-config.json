{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "tag-separator": "--",
  "bump-minor-pre-major": true,
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Changed" },
    { "type": "revert", "section": "Reverted" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "litellm-key",
      "extra-files": [
        { "type": "json", "path": "plugins/litellm-key/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.plugins[?(@.name=='litellm-key')].version" }
      ]
    }
  }
}
